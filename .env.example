# DeepSeek Proxy Configuration  
# 
# Get your token from: https://chat.deepseek.com
# 1. Open DeepSeek in your browser  
# 2. Press F12 to open DevTools
# 3. Go to Application -> Local Storage -> chat.deepseek.com
# 4. Find: localStorage.getItem("userToken")
# 5. Copy the value and paste it below
#
DEEPSEEK_USER_TOKEN=BELOW_TOKEN_HERE
CF_CLEARANCE=
HOST=127.0.0.1
PORT=8000
DEFAULT_MODEL=expert